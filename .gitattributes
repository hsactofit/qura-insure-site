# Keep text files consistent across Windows, macOS, and Linux.
* text=auto eol=lf

# Windows command scripts use native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve binary assets byte-for-byte.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
